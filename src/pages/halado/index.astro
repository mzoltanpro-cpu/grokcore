---
import Base from "../../layouts/Base.astro";
import { advancedFetchedDates, advancedGuides, advancedPath } from "../../content/advanced";
import { absUrl, siteConfig, siteOrigin } from "../../lib/site";

const origin = siteOrigin(Astro.site);
const path = "/halado/";
const title = `Haladó Grok Bot útmutatók magyarul | ${siteConfig.name}`;
const description =
  "A Botkezdő saját haladó Grok Bot útmutatói a Kezdő 5 nap után: botcsapat, rutinok ütemezése, második agy fájlokból, helyi SEO-promptok, nyomtató rendbetétele. Nem hivatalos x.ai anyag, forrásolva.";

const ld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Haladó Grok Bot útmutatók (Botkezdő, nem hivatalos)",
  description,
  inLanguage: "hu",
  url: absUrl(origin, path),
  numberOfItems: advancedGuides.length,
  itemListElement: advancedGuides.map((guide, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: absUrl(origin, advancedPath(guide.slug)),
    name: guide.title,
  })),
};
---

<Base
  title={title}
  description={description}
  path={path}
  current="advanced"
  jsonLd={[ld]}
  crumbs={[
    { name: siteConfig.name, path: "/" },
    { name: "Haladó útmutatók", path },
  ]}
>
  <p class="eyebrow">Saját útmutatók · a Kezdő 5 nap után · {advancedGuides.length} útmutató</p>
  <h1>Haladó útmutatók (saját)</h1>
  <p class="lede">
    Ha megvan az első Botod, az első routine-od és a jóváhagyási szabályaid, innen léphetsz tovább: több Botból csapat,
    takarékos rutinok, egy Bot, amely fájlokban tartja, amit rólad tudnia kell, valamint két közösségi forrás
    összefoglalója: helyi SEO-promptok és egy otthoni nyomtató rendbetétele egy prompttal.
  </p>
  <aside class="note" aria-label="Nem hivatalos anyag" data-own-guides>
    <p>
      <strong>Ezek a Botkezdő saját útmutatói, nem hivatalos x.ai anyagok.</strong> A hivatalos guide-okat az
      <a href="/utmutatok/">Útmutatók</a> oldalon találod.
    </p>
  </aside>
  <aside class="note" aria-label="Forrásokról">
    <p>
      <strong>Saját magyar szöveg, forrással.</strong> Az útmutatókat mi írtuk, nem fordítások. Forrásként az x.ai
      oldalán megjelent, xAI-munkatársak által írt útmutatókat (gyártói forrás), közösségi X-cikkeket és a docs.x.ai
      dokumentációt használtuk. Minden oldalon ott a szerző, a link, a dátum
      és a forrás típusa. Ami nem ellenőrzött, [ELLENŐRIZENDŐ] jelölést kap. Források lekérve: {advancedFetchedDates}.
    </p>
  </aside>
  <section class="section" aria-labelledby="utmutatok-lista">
    <div class="section-head">
      <h2 id="utmutatok-lista">Az útmutatók</h2>
    </div>
    <ul class="bot-grid plain-list">
      {
        advancedGuides.map((guide, index) => (
          <li class="bot-card" data-advanced={guide.slug}>
            <h3 class="bot-name">
              <a href={advancedPath(guide.slug)}>
                {index + 1}. {guide.title}
              </a>
            </h3>
            <p class="bot-by">{guide.minutes}</p>
            <p>{guide.card}</p>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="section" aria-labelledby="meg-nem">
    <div class="section-head">
      <h2 id="meg-nem">Még az elején tartasz?</h2>
    </div>
    <p>
      Ezek az oldalak a <a href="/5-nap/">Kezdő 5 nap</a> anyagára építenek. Az x.ai hivatalos angol útmutatóinak rövid magyar
      összefoglalóját külön, az <a href="/utmutatok/">Útmutatók</a> oldalon találod.
    </p>
  </section>
</Base>

---
import Base from "../../layouts/Base.astro";
import TemplateNote from "../../components/TemplateNote.astro";
import {
  budapestTime,
  communityTemplates,
  templateCategoryCounts,
  templateCategoryKey,
  templatePath,
} from "../../content/templates";
import { officialTemplates } from "../../content/official";
import { absUrl, siteConfig, siteOrigin } from "../../lib/site";

const origin = siteOrigin(Astro.site);
const title = `Közösségi botsablonok magyarul: nem hivatalos gyűjtemény | ${siteConfig.name}`;
const description = `Az X-en megosztott, x.ai/bot/… linkes Grok Bot-sablonok saját magyar összefoglalóval: mire jók, mit állít róluk a forrás, és honnan adhatod hozzá őket. ${communityTemplates.length} sablon, forrással.`;
const first = communityTemplates[0];

const ld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Közösségi botsablonok – nem hivatalos magyar gyűjtemény",
  description,
  inLanguage: "hu",
  numberOfItems: communityTemplates.length,
  itemListOrder: "https://schema.org/ItemListUnordered",
  itemListElement: communityTemplates.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: absUrl(origin, templatePath(item.slug)),
    name: item.name,
  })),
};
---

<Base
  title={title}
  description={description}
  path="/sablonok/"
  current="templates"
  jsonLd={[ld]}
  crumbs={[
    { name: siteConfig.name, path: "/" },
    { name: "Közösségi botsablonok", path: "/sablonok/" },
  ]}
>
  <p class="eyebrow">Nem hivatalos gyűjtemény · {communityTemplates.length} sablon</p>
  <h1>Közösségi botsablonok</h1>
  <p class="lede">
    Felhasználók által az X-en megosztott botsablonok, mindegyik egy saját, rövid magyar összefoglalóval. Ezek nem a
    hivatalos <a href="/marketplace/">Marketplace</a> botjai, hanem bárki által készített és linkkel megosztott sablonok. A
    sablon neve, a szakszavak és az idézetek eredetiben maradnak.
  </p>
  <p class="fine" data-cross-link>
    Az x.ai saját, hivatalos sablonjait magyar összefoglalóval a <a href="/hivatalos-sablonok/">Hivatalos sablonok</a> oldalon
    találod ({officialTemplates.length} sablon).
  </p>
  <TemplateNote />

  <section class="section" aria-labelledby="sablonlista">
    <div class="section-head">
      <h2 id="sablonlista">A sablonok</h2>
      <p>
        A kategóriák a Botkezdő besorolásai a sablon neve és a magyar összefoglaló alapján. Szűrj kategóriára, vagy keress
        névre, készítőre és összefoglalóra. JavaScript nélkül minden sablon látszik.
      </p>
    </div>
    <div class="mp-filters" data-tpl-filters>
      <div class="field">
        <label for="tpl-q">Keresés</label>
        <input
          id="tpl-q"
          type="search"
          name="q"
          placeholder="pl. naptár, Gmail, @handle"
          autocomplete="off"
          data-tpl-q
        />
      </div>
      <div class="field">
        <label for="tpl-cat">Kategória</label>
        <select id="tpl-cat" name="kategoria" data-tpl-cat>
          <option value="">Mind</option>
          {
            templateCategoryCounts().map((item) => (
              <option value={templateCategoryKey(item.category)}>
                {item.category} ({item.count})
              </option>
            ))
          }
        </select>
      </div>
      <p class="status" role="status" aria-live="polite" data-tpl-count>{communityTemplates.length} sablon</p>
    </div>
    <ul class="bot-grid plain-list" data-tpl-list>
      {
        communityTemplates.map((item) => (
          <li
            class="bot-card"
            data-template={item.slug}
            data-cats={item.categories.map(templateCategoryKey).join(" ")}
            data-search={[item.name, item.author, item.handle, item.summaryHu, ...item.categories].join(" ")}
          >
            <h3 class="bot-name">
              <a href={templatePath(item.slug)}>{item.name}</a>
            </h3>
            <p class="bot-by">
              {item.author} ({item.handle}) · {budapestTime(item.postedAt)}
            </p>
            <p class="tag-row">
              {item.categories.map((category) => (
                <span class="tag">{category}</span>
              ))}
            </p>
            <p>{item.summaryHu}</p>
            <p class="fine">
              <a href={templatePath(item.slug)}>Részletek</a> · {item.postUrl && <><a href={item.postUrl}>X-poszt</a> ·{" "}</>}
              {item.templateRemoved ? <span>Sablon (x.ai): már nem elérhető</span> : <a href={item.templateUrl}>Sablon (x.ai)</a>}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="fine" data-tpl-empty hidden>Nincs találat. Próbálj kevesebb szűrőt.</p>
  </section>

  <section class="section" aria-labelledby="hozzaadas">
    <div class="section-head">
      <h2 id="hozzaadas">Hogyan adhatsz hozzá egy sablont?</h2>
    </div>
    <ol class="checklist">
      <li>Nyisd meg a sablon <code>x.ai/bot/…</code> linkjét. Minden adatlap Forrás blokkjában ott van.</li>
      <li>
        A lapon az <strong lang="en">Add to Grok Bot</strong> gomb adja hozzá a sablont. A lap szerint a gombra kattintva
        elfogadod a feltételeket.
      </li>
      <li>Ha még nincs meg az app, ugyanezen a lapon a <span lang="en">„Don't have Grok Bot? Download”</span> linkkel töltheted le.</li>
      <li>
        A lap figyelmeztet is: a botot egy külső felhasználó készítette, nem a SpaceXSI, és a nevedben is cselekedhet (<span
          lang="en">„It may act on your behalf.”</span>).
      </li>
    </ol>
    {
      first && (
        <p class="fine">
          Forrás: a <a href={first.templateUrl}>{first.name} sablonlapja (x.ai)</a>, lekérve: {first.fetched}.
        </p>
      )
    }
  </section>

  <section class="section" aria-labelledby="hogyan">
    <div class="section-head">
      <h2 id="hogyan">Hogyan készült?</h2>
    </div>
    <ul class="checklist">
      <li>Minden sablon a készítő nyilvános X-posztjából és a sablon nyilvános x.ai lapjából származik, mindkettő linkelve.</li>
      <li>A magyar összefoglaló a sajátunk, nem fordítás. Angol szöveg csak idézetként jelölve szerepel.</li>
      <li>Nem írunk funkciót, amit a forrás nem említ. Ami hiányzik, azt jelöljük: „A listing nem tartalmaz erről adatot.”</li>
      <li>Új sablon csak ellenőrzés után kerül a gyűjteménybe.</li>
    </ul>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-tpl-filters]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-template]")];
  const count = document.querySelector<HTMLElement>("[data-tpl-count]");
  const empty = document.querySelector<HTMLElement>("[data-tpl-empty]");
  if (root) {
    const q = root.querySelector<HTMLInputElement>("[data-tpl-q]")!;
    const cat = root.querySelector<HTMLSelectElement>("[data-tpl-cat]")!;
    const fold = (value: string) => value.toLowerCase().normalize("NFD").replace(/\p{M}/gu, "");
    const apply = () => {
      const text = fold(q.value.trim());
      let shown = 0;
      for (const card of cards) {
        const cats = card.dataset.cats ?? "";
        const ok =
          (!cat.value || cats.split(" ").includes(cat.value)) &&
          (!text || fold(card.dataset.search ?? "").includes(text));
        card.hidden = !ok;
        if (ok) shown += 1;
      }
      if (count) count.textContent = `${shown} sablon`;
      if (empty) empty.hidden = shown !== 0;
      const params = new URLSearchParams();
      const raw = q.value.trim();
      if (raw) params.set("q", raw);
      if (cat.value) params.set("kategoria", cat.value);
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}#sablonlista` : location.pathname);
    };
    const params = new URLSearchParams(location.search);
    q.value = params.get("q") ?? "";
    const category = params.get("kategoria") ?? "";
    if ([...cat.options].some((option) => option.value === category)) cat.value = category;
    for (const el of [q, cat]) el.addEventListener("input", apply);
    if (location.search) apply();
  }
</script>

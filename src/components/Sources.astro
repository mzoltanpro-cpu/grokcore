---
import type { Source } from "../content/types";
import { siteConfig } from "../lib/site";

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<section class="sources">
  <h2>Források</h2>
  <ul>
    {
      sources.map((source) => (
        <li>
          <a href={source.url}>{source.title}</a>
        </li>
      ))
    }
  </ul>
  <p class="fine">
    Az oldalon minden Grok Bot-funkcióra vonatkozó állítás a fenti nyilvános forrásokon alapul (lekérve:
    {siteConfig.updated}). A saját példáinkat, a fordításainkat és a körülbelül 15 perces becslést külön
    megjelöljük. A felület feliratai változhatnak.
  </p>
</section>

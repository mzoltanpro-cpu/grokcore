---
import { primaryNav, siteConfig } from "../lib/site";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<a class="skip" href="#tartalom">Ugrás a tartalomra</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">5</span>
      <span>{siteConfig.name}</span>
    </a>
    <nav class="nav" aria-label="Fő navigáció">
      {
        primaryNav.map((item) => (
          <a href={item.href} aria-current={current === item.id ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Téma váltása"
      title="Téma váltása"
    >
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        <path
          d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M5.3 18.7l1.55-1.55M17.15 6.85l1.55-1.55"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path>
      </svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path
          d="M20.2 14.6A8.3 8.3 0 0 1 9.4 3.8a8.3 8.3 0 1 0 10.8 10.8Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>
